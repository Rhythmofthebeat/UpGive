# Copy this file to ".env" (same folder as package.json) and fill in your values.
# .env is gitignored — never commit real keys. On Vercel, set these same two
# variables in Project → Settings → Environment Variables, then redeploy.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key